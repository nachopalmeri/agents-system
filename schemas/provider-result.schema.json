{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nachopalmeri/agents-system/schemas/provider-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["status", "retryable"],
  "properties": { "status": { "enum": ["SUCCESS", "PROVIDER_REFUSAL", "RATE_LIMITED", "BLOCKED", "NEEDS_USER"] }, "provider": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string", "maxLength": 240 }, "retryable": { "type": "boolean" }, "retryAfterSeconds": { "type": "integer", "minimum": 0 }, "usage": { "type": "object", "additionalProperties": false, "properties": { "toolCalls": { "type": "integer", "minimum": 0 }, "inputTokens": { "type": "integer", "minimum": 0 }, "outputTokens": { "type": "integer", "minimum": 0 }, "costUsd": { "type": "number", "minimum": 0 } } } }
}
