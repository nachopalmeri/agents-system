{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nachopalmeri/agents-system/schemas/agent.schema.json",
  "title": "Agents System Registry",
  "type": "object",
  "required": ["version", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file",
          "division",
          "description",
          "whenToUse",
          "inputs",
          "outputs",
          "riskLevel",
          "tools",
          "requiresApproval",
          "memoryTags"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 3
          },
          "file": {
            "type": "string",
            "pattern": "^\\.agents/agents/.+\\.md$"
          },
          "division": {
            "type": "string",
            "minLength": 2
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "whenToUse": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "inputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 3
            }
          },
          "riskLevel": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "requiresApproval": {
            "type": "boolean"
          },
          "memoryTags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["project", "user", "team", "run"]
            }
          }
        }
      }
    }
  }
}

