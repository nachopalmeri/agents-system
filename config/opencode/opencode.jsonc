{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen 2.5 Coder 7B"
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      "logs/**",
      "*.log"
    ]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch --show-current*": "allow",
      "git push*": "ask",
      "git remote*": "ask",
      "git branch*": "ask",
      "Remove-Item*": "ask",
      "rm *": "ask",
      "del *": "ask",
      "winget install*": "ask"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": false
    }
  },
  "tools": {
    "context7_*": false,
    "gh_grep_*": false,
    "sentry_*": false
  },
  "agent": {
    "free-researcher": {
      "description": "Bounded read-only research and mechanical checks",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": { "edit": "deny", "bash": "ask" }
    },
    "free-red-team": {
      "description": "Preliminary read-only red-team review",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": { "edit": "deny", "bash": "ask" }
    },
    "free-worker": {
      "description": "Bounded harmless local implementation with parent review",
      "mode": "subagent",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "permission": { "edit": "allow", "bash": "ask" }
    }
  },
  "instructions": []
}
