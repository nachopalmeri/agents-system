{
  "_note": "Reglas de secretos compartidas por secrets-guard.py (Claude Code WSL y Windows) y el plugin zentra-guard de OpenCode. Regex sobre rutas normalizadas: minúsculas y con '/'. Editar acá y copiar a los 3 lugares (ver ROLLBACK-guardrails-20261114.txt).",
  "path_patterns": [
    "(^|/)\\.env(\\.(?!example$|sample$|template$|dist$)[^/]+)?$",
    "(^|/)[^/]+\\.env$",
    "\\.(pem|key|p12|pfx|jks|keystore|ppk)$",
    "(^|/)id_(rsa|dsa|ecdsa|ed25519)(?!.*\\.pub$)[^/]*$",
    "(^|/)\\.?(credentials|creds)(\\.[a-z0-9]+)?$",
    "(^|/)[^/]*credentials[^/]*\\.(json|ya?ml|toml|ini|txt|env|xml|csv)$",
    "(^|/)\\.config/secrets(/|$)",
    "(^|/)\\.secrets?(/|$)",
    "(^|/)secrets?\\.(json|ya?ml|toml|env|txt|ini)$",
    "(^|/)\\.aws(/|$)",
    "(^|/)\\.ssh/(?!known_hosts|config$|[^/]*\\.pub$)",
    "(^|/)\\.gnupg(/|$)",
    "(^|/)\\.docker/config\\.json$",
    "(^|/)\\.kube/config$",
    "(^|/)\\.(netrc|git-credentials|pgpass|npmrc|pypirc)$",
    "(^|/)\\.dev\\.vars(\\.[^/]+)?$",
    "(^|/)\\.?wrangler/config(/|$)",
    "(^|/)\\.config/\\.?wrangler(/|$)",
    "(^|/)\\.supabase/access-token$",
    "(^|/)\\.config/supabase(/|$)",
    "(^|/)\\.claude/\\.credentials\\.json$",
    "(^|/)\\.codex/auth\\.json$",
    "(^|/)opencode/auth\\.json$",
    "(^|/)\\.config/gh/hosts\\.ya?ml$",
    "(^|/)(\\.vercel|com\\.vercel\\.cli)/auth\\.json$",
    "(^|/)service[-_]?account[^/]*\\.json$",
    "(^|/)[^/]*(tiendanube|nuvemshop|tn)[-_.]?(token|credential|secret|auth|keys?)[^/]*$",
    "(^|/)[^/]*(supabase|cloudflare|cf)[-_.]?(token|secret|service[-_]?role|api[-_]?keys?)[^/]*$"
  ],
  "env_var_name": "[a-z0-9_]*(token|secret|password|passwd|api_?key|private_key|service_role|access_key|client_secret|tiendanube|nuvemshop|tn_access|supabase_(service|access|db)|cloudflare_api|cf_api|deepseek)[a-z0-9_]*",
  "safe_bash_verbs": [
    "ls",
    "test",
    "[",
    "[[",
    "stat",
    "touch",
    "chmod",
    "chown",
    "mkdir",
    "wc",
    "file",
    "dirname",
    "basename",
    "realpath",
    "readlink"
  ]
}