{
  "schemaVersion": 2,
  "laneBudgets": {
    "SIMPLE": { "maxIterations": 3, "maxReplans": 1, "maxAgents": 1 },
    "SPECIALIZED": { "maxIterations": 6, "maxReplans": 2, "maxAgents": 1 },
    "PARALLEL": { "maxIterations": 8, "maxReplans": 2, "maxAgents": 4 },
    "HIGH_RISK": { "maxIterations": 5, "maxReplans": 1, "maxAgents": 2 }
  },
  "capabilityByAgent": {
    "agente-principal": "general-implementation",
    "agente-researcher": "current-research",
    "agente-design": "frontend-design",
    "agente-growth-seo-geo": "seo-geo-aeo",
    "agente-academic-tutor": "academic-tutoring",
    "agente-obsidian-brain": "obsidian-knowledge",
    "agente-security-auditor": "security-review",
    "agente-release-manager": "release-publication"
  },
  "highRisk": [
    {
      "reason": "risk-release",
      "primary": "agente-release-manager",
      "patterns": ["\\bpublish(?: the)? production release\\b", "\\bdeploy(?: it)? to production\\b", "\\brelease to production\\b", "\\bpublicar(?: el| la)? release\\b"]
    },
    {
      "reason": "risk-credentials",
      "primary": "agente-security-auditor",
      "patterns": ["\\b(?:rotate|update|replace|expose|share)\\b.{0,40}\\b(?:secret|token|credential|api key)\\b", "\\b(?:rota|actualiza|reemplaza|expone|comparti)\\w*\\b.{0,40}\\b(?:secreto|token|credencial|api key)\\b"]
    },
    {
      "reason": "risk-production-write",
      "primary": "agente-security-auditor",
      "patterns": ["\\b(?:write|migrate|delete|deploy)\\w*\\b.{0,60}\\bproduction\\b", "\\b(?:escrib|migr|borr|despleg)\\w*\\b.{0,60}\\b(?:produccion|productiva)\\b"]
    },
    {
      "reason": "risk-payment",
      "primary": "agente-security-auditor",
      "patterns": ["\\b(?:make|execute|send|charge)\\w*\\b.{0,40}\\b(?:payment|card|purchase)\\b", "\\b(?:realiza|ejecuta|envia|cobra|compra)\\w*\\b.{0,40}\\b(?:pago|tarjeta|suscripcion)\\b"]
    },
    {
      "reason": "risk-external-message",
      "primary": "agente-security-auditor",
      "patterns": ["\\b(?:send|post)\\w*\\b.{0,40}\\b(?:external dm|customer message|email)\\b", "\\b(?:envia|manda|publica)\\w*\\b.{0,40}\\b(?:dm|mensaje|email)\\b"]
    },
    {
      "reason": "risk-destructive",
      "primary": "agente-security-auditor",
      "patterns": ["\\b(?:delete|remove|drop|destroy)\\b.{0,50}\\b(?:all|recursively|customer data|database)\\b", "\\b(?:borra|elimina|destrui)\\w*\\b.{0,50}\\b(?:todo|recursiv|datos|base de datos)\\b"]
    }
  ],
  "parallel": {
    "patterns": ["\\bin parallel\\b", "\\bparallel tracks?\\b", "\\bindependent agents?\\b", "\\bmultiple independent advisers?\\b", "\\ben paralelo\\b", "\\bagentes independientes\\b", "\\basesores paralelos\\b"],
    "councilPatterns": ["\\bllm council\\b", "\\bthe council\\b", "\\bactiva(?: el)? council\\b", "\\busa(?: el)? council\\b"]
  },
  "specialists": [
    {
      "priority": 10,
      "reason": "specialist-academic",
      "primary": "agente-academic-tutor",
      "component": ".agents/workflows/academic_tutor.md",
      "patterns": ["\\bparcial(?:es)?\\b", "\\bexam prep\\b", "\\bstudy session\\b", "\\bpracticar\\b.{0,30}\\b(?:economia|programacion|materia)\\b", "\\btomame(?:\\sun)?\\b.{0,30}\\b(?:parcial|examen|quiz)\\b", "\\brepasar\\b.{0,30}\\b(?:para el|materia|tema)\\b"],
      "negativeTriggers": ["\\bvista parcial\\b", "\\bactualizacion parcial\\b", "\\bparcial(?:mente)?\\b.{0,15}\\b(?:deploy|migration|update|fix|refactor|render|view|aplicacion|merge|rollback)\\b", "\\bpartial\\b.{0,15}\\b(?:update|render|view|deploy|migration|merge|rollback)\\b"]
    },
    {
      "priority": 20,
      "reason": "specialist-obsidian",
      "primary": "agente-obsidian-brain",
      "component": ".agents/skills/obsidian-vault/SKILL.md",
      "patterns": ["\\bobsidian\\b", "\\bvault\\b.{0,20}\\b(?:nota|note|captur|organiz|link|tag|folder)\\b", "\\bzettelkasten\\b", "\\bmoc\\b.{0,15}\\b(?:crear|organiz|update)\\b"],
      "negativeTriggers": ["\\bvault\\b.{0,15}\\b(?:secret|hashicorp|credential|token|aws|azure)\\b", "\\bkey vault\\b"]
    },
    {
      "priority": 30,
      "reason": "specialist-growth-search",
      "primary": "agente-growth-seo-geo",
      "component": ".agents/skills/seo-geo-growth/SKILL.md",
      "patterns": ["\\bgeo strategy\\b", "\\bestrategia geo\\b", "\\baeo\\b", "\\bai search visibility\\b", "\\bvisibilidad en buscadores de ia\\b", "\\bkeyword strategy\\b", "\\bprogrammatic seo\\b", "\\bbacklog 30.?60.?90\\b"],
      "negativeTriggers": ["\\bcanonical\\b.{0,20}\\b(?:tag|url|link)\\b", "\\brobots\\.txt\\b", "\\bsitemap\\.xml\\b", "\\bschema markup\\b", "\\bmeta description\\b"]
    },
    {
      "priority": 40,
      "reason": "specialist-technical-seo",
      "primary": "agente-seo",
      "component": null,
      "patterns": ["\\btechnical seo\\b", "\\bseo tecnico\\b", "\\bcanonical\\b", "\\bsitemap\\b", "\\brobots\\.txt\\b", "\\bschema markup\\b", "\\bmeta tags?\\b", "\\bcore web vitals\\b", "\\bstructured data\\b"],
      "negativeTriggers": ["\\bkeyword\\b.{0,20}\\b(?:strategy|research|backlog)\\b", "\\bprogrammatic\\b", "\\bgeo\\b", "\\baeo\\b", "\\bgrowth\\b.{0,15}\\bstrategy\\b"]
    },
    {
      "priority": 50,
      "reason": "specialist-product",
      "primary": "agente-product-founder",
      "component": ".agents/skills/product-foundry/SKILL.md",
      "patterns": ["\\bproduct mvp\\b", "\\bmvp scope\\b", "\\bidea de producto\\b", "\\bproduct idea\\b", "\\bdemand validation\\b", "\\bkill or scale\\b", "\\bvalidar(?:\\sla)?\\s(?:idea|demanda)\\b"],
      "negativeTriggers": ["\\bproduct(?:o)?\\b.{0,10}\\b(?:of|de|entre)\\b.{0,15}\\b(?:two|dos|number|numero)\\b", "\\bcartesian product\\b", "\\bdot product\\b", "\\bproducto escalar\\b", "\\bproducto cartesiano\\b"]
    },
    {
      "priority": 60,
      "reason": "specialist-ai-architecture",
      "primary": "agente-ai-architect",
      "component": ".agents/skills/ai-production-architecture/SKILL.md",
      "patterns": ["\\bproduction rag\\b", "\\brag architecture\\b", "\\bllm architecture\\b", "\\bai architecture\\b", "\\bsemantic cache\\b", "\\bprompt registry\\b", "\\bvector database\\b", "\\bembedding pipeline\\b"],
      "negativeTriggers": ["\\bai\\b.{0,10}\\b(?:explain|que es|what is)\\b"]
    },
    {
      "priority": 70,
      "reason": "specialist-frontend-design",
      "primary": "agente-design",
      "component": ".agents/skills/frontend-design/SKILL.md",
      "patterns": ["\\bdesign a responsive\\b", "\\bvisual system\\b", "\\bfrontend design\\b", "\\bdisena\\w*\\b.{0,30}\\blanding\\b", "\\baccessible ui\\b", "\\bdesign system\\b", "\\bcomponent library\\b"],
      "negativeTriggers": ["\\bdesign pattern\\b", "\\bsystem design\\b.{0,15}\\b(?:interview|entrevista)\\b"]
    },
    {
      "priority": 80,
      "reason": "specialist-current-research",
      "primary": "agente-researcher",
      "component": null,
      "patterns": ["\\bcurrent official documentation\\b", "\\blatest supported\\b", "\\bresearch the current\\b", "\\binvestiga(?: la)? documentacion actual\\b", "\\bprimary sources\\b", "\\bcompara\\w*\\b.{0,20}\\b(?:guias|docs|versiones)\\b.{0,15}\\b(?:actual|oficial|hoy)\\b"],
      "negativeTriggers": ["\\bexplica\\b.{0,15}\\b(?:este|esta|el|la|un|una)\\b.{0,15}\\b(?:archivo|funcion|clase|variable)\\b"]
    },
    {
      "priority": 90,
      "reason": "specialist-code-review",
      "primary": "agente-code-reviewer",
      "component": null,
      "patterns": ["\\bcode review\\b", "\\breview this pr\\b", "\\brevisa(?: este| el)? diff\\b", "\\brevision de codigo\\b", "\\breview my changes\\b"],
      "negativeTriggers": ["\\breview\\b.{0,10}\\b(?:the docs|la documentacion|this article)\\b"]
    }
  ]
}
